+    "starter": "type Status = \"todo\" | \"in-progress\" | \"done\";\n\ninterface Task {\n  id: number;\n  title: string;\n  status: Status;\n  dueDate?: string;\n}\n\nfunction filterByStatus(tasks: Task[], status: Status): Task[] {\n  return [];\n}\n\nfunction countByStatus(tasks: Task[]): Record<Status, number> {\n  return {\n    todo: 0,\n    \"in-progress\": 0,\n    done: 0\n  };\n}\n\nfunction firstOrNull<T>(items: T[]): T | null {\n  return null;\n}",
+    "solution": "type Status = \"todo\" | \"in-progress\" | \"done\";\n\ninterface Task {\n  id: number;\n  title: string;\n  status: Status;\n  dueDate?: string;\n}\n\nfunction filterByStatus(tasks: Task[], status: Status): Task[] {\n  return tasks.filter(task => task.status === status);\n}\n\nfunction countByStatus(tasks: Task[]): Record<Status, number> {\n  const counts: Record<Status, number> = {\n    todo: 0,\n    \"in-progress\": 0,\n    done: 0\n  };\n\n  for (const task of tasks) {\n    counts[task.status] += 1;\n  }\n\n  return counts;\n}\n\nfunction firstOrNull<T>(items: T[]): T | null {\n  return items.length > 0 ? items[0] : null;\n}",
