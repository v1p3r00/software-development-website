+    "starter": "const { useState } = React;\n\nconst tasks = [\n  { id: 1, title: 'Prepare weekly report', done: false },\n  { id: 2, title: 'Review project report', done: true },\n  { id: 3, title: 'Fix login bug', done: false },\n  { id: 4, title: 'Update documentation', done: true },\n  { id: 5, title: 'Plan customer meeting', done: false },\n];\n\nfunction App() {\n  const [search, setSearch] = useState('');\n  const [status, setStatus] = useState('all');\n\n  return (\n    <main>\n      <h1>Task filter</h1>\n\n      <label htmlFor=\"search\">Search tasks</label>\n      <input\n        id=\"search\"\n        type=\"text\"\n        value={search}\n        onChange={(event) => setSearch(event.target.value)}\n      />\n\n      <label htmlFor=\"status\">Status</label>\n      <select\n        id=\"status\"\n        value={status}\n        onChange={(event) => setStatus(event.target.value)}\n      >\n        <option value=\"all\">all</option>\n        <option value=\"open\">open</option>\n        <option value=\"done\">done</option>\n      </select>\n\n      <p role=\"status\">5 tasks</p>\n\n      <ul aria-label=\"Tasks\">\n        {tasks.map((task) => (\n          <li key={task.id}>{task.title}</li>\n        ))}\n      </ul>\n    </main>\n  );\n}\n",
+    "solution": "const { useState } = React;\n\nconst tasks = [\n  { id: 1, title: 'Prepare weekly report', done: false },\n  { id: 2, title: 'Review project report', done: true },\n  { id: 3, title: 'Fix login bug', done: false },\n  { id: 4, title: 'Update documentation', done: true },\n  { id: 5, title: 'Plan customer meeting', done: false },\n];\n\nfunction App() {\n  const [search, setSearch] = useState('');\n  const [status, setStatus] = useState('all');\n\n  const filteredTasks = tasks.filter((task) => {\n    const matchesSearch = task.title.toLowerCase().includes(search.trim().toLowerCase());\n    const matchesStatus =\n      status === 'all' ||\n      (status === 'done' && task.done) ||\n      (status === 'open' && !task.done);\n\n    return matchesSearch && matchesStatus;\n  });\n\n  return (\n    <main>\n      <h1>Task filter</h1>\n\n      <label htmlFor=\"search\">Search tasks</label>\n      <input\n        id=\"search\"\n        type=\"text\"\n        value={search}\n        onChange={(event) => setSearch(event.target.value)}\n      />\n\n      <label htmlFor=\"status\">Status</label>\n      <select\n        id=\"status\"\n        value={status}\n        onChange={(event) => setStatus(event.target.value)}\n      >\n        <option value=\"all\">all</option>\n        <option value=\"open\">open</option>\n        <option value=\"done\">done</option>\n      </select>\n\n      <p role=\"status\">\n        {filteredTasks.length === 0\n          ? 'No tasks match'\n          : `${filteredTasks.length} ${filteredTasks.length === 1 ? 'task' : 'tasks'}`}\n      </p>\n\n      <ul aria-label=\"Tasks\">\n        {filteredTasks.map((task) => (\n          <li key={task.id}>{task.title}</li>\n        ))}\n      </ul>\n    </main>\n  );\n}\n",
+    "hint": "Z pevného zoznamu úloh vypočítaj vyfiltrované pole. Porovnaj vyhľadávaný text prevedený na malé písmená a orezaný o medzery s každým názvom a potom aplikuj vybraný stav: all prijme každú úlohu, open prijme úlohy, kde je done false, a done prijme úlohy, kde je done true. Vyrenderuj vyfiltrované pole namiesto pôvodného poľa tasks a správu o stave odvoď z filteredTasks.length.",
+    "tests": [
+      {
+        "name": "Na začiatku vyrenderuje prístupné ovládacie prvky filtra a všetkých päť úloh",
+        "code": "const search = document.querySelector('label[for=\"search\"] + input');\nconst status = document.querySelector('label[for=\"status\"] + select');\nconst list = document.querySelector('ul[aria-label=\"Tasks\"]');\nconst items = [...list.querySelectorAll('li')];\n\nif (!search || search.getAttribute('type') !== 'text') throw new Error('Search input is missing');\nif (!status) throw new Error('Status select is missing');\nif (status.querySelectorAll('option').length !== 3) throw new Error('Expected three status options');\nif (items.length !== 5) throw new Error('Expected all five tasks initially');\nif (document.querySelector('[role=\"status\"]').textContent.trim() !== '5 tasks') throw new Error('Expected 5 tasks status');"
+      },
+      {
+        "name": "Filtruje úlohy cez pole s popisom Search tasks",
+        "code": "const input = document.querySelector('label[for=\"search\"] + input');\nif (!input) throw new Error('Search input is missing');\n\nawait typeInto(input, 'report');\nawait tick();\n\nconst items = [...document.querySelector('ul[aria-label=\"Tasks\"]').querySelectorAll('li')].map((li) => li.textContent.trim());\nif (items.length !== 2) throw new Error(`Expected 2 report tasks, got ${items.length}`);\nif (!items.every((title) => title.toLowerCase().includes('report'))) throw new Error('A non-report task was rendered');\nif (document.querySelector('[role=\"status\"]').textContent.trim() !== '2 tasks') throw new Error('Expected 2 tasks status');"
+      },
+      {
+        "name": "Po zmene Status na done vyfiltruje dokončené úlohy",
+        "code": "const select = document.querySelector('label[for=\"status\"] + select');\nif (!select) throw new Error('Status select is missing');\n\nselect.value = 'done';\nselect.dispatchEvent(new Event('change', { bubbles: true }));\nawait tick();\n\nconst items = [...document.querySelector('ul[aria-label=\"Tasks\"]').querySelectorAll('li')].map((li) => li.textContent.trim());\nconst expected = ['Review project report', 'Update documentation'];\nif (items.length !== expected.length) throw new Error(`Expected ${expected.length} completed tasks, got ${items.length}`);\nfor (const title of expected) {\n  if (!items.includes(title)) throw new Error(`Missing completed task: ${title}`);\n}\nif (document.querySelector('[role=\"status\"]').textContent.trim() !== '2 tasks') throw new Error('Expected 2 tasks status');"
+      },
+      {
+        "name": "Kombinuje filtre vyhľadávania a stavu",
+        "code": "const input = document.querySelector('label[for=\"search\"] + input');\nconst select = document.querySelector('label[for=\"status\"] + select');\nif (!input || !select) throw new Error('Filter controls are missing');\n\nawait typeInto(input, 'report');\nawait tick();\nselect.value = 'done';\nselect.dispatchEvent(new Event('change', { bubbles: true }));\nawait tick();\n\nconst items = [...document.querySelector('ul[aria-label=\"Tasks\"]').querySelectorAll('li')].map((li) => li.textContent.trim());\nif (items.length !== 1) throw new Error(`Expected one completed report, got ${items.length}`);\nif (items[0] !== 'Review project report') throw new Error('Wrong task remained after combining filters');\nif (document.querySelector('[role=\"status\"]').textContent.trim() !== '1 task') throw new Error('Expected singular 1 task status');"
+      },
