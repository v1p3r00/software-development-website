+    "solution": "const INITIAL_TICKETS = [\n  { id: 1, title: \"Invoice missing\", status: \"open\" },\n  { id: 2, title: \"Change delivery address\", status: \"closed\" },\n  { id: 3, title: \"Login problem\", status: \"open\" }\n];\n\nfunction App() {\n  const [tickets, setTickets] = React.useState(() => INITIAL_TICKETS.map((ticket) => ({ ...ticket })));\n  const [filter, setFilter] = React.useState(\"all\");\n  const [title, setTitle] = React.useState(\"\");\n  const [error, setError] = React.useState(\"\");\n\n  const visibleTickets = tickets.filter((ticket) => {\n    return filter === \"all\" || ticket.status === filter;\n  });\n\n  function closeTicket(id) {\n    setTickets((current) =>\n      current.map((ticket) =>\n        ticket.id === id ? { ...ticket, status: \"closed\" } : ticket\n      )\n    );\n  }\n\n  function createTicket(event) {\n    event.preventDefault();\n    const trimmed = title.trim();\n\n    if (trimmed.length < 5) {\n      setError(\"Title must be at least 5 characters\");\n      return;\n    }\n\n    setTickets((current) => {\n      const nextId = current.reduce((max, ticket) => Math.max(max, ticket.id), 0) + 1;\n      return [...current, { id: nextId, title: trimmed, status: \"open\" }];\n    });\n    setTitle(\"\");\n    setError(\"\");\n  }\n\n  const openCount = tickets.filter((ticket) => ticket.status === \"open\").length;\n\n  return (\n    <main>\n      <h1>Tickets</h1>\n\n      <label>\n        Status filter\n        <select\n          aria-label=\"Status filter\"\n          value={filter}\n          onChange={(event) => setFilter(event.target.value)}\n        >\n          <option value=\"all\">all</option>\n          <option value=\"open\">open</option>\n          <option value=\"closed\">closed</option>\n        </select>\n      </label>\n\n      <ul aria-label=\"Tickets\">\n        {visibleTickets.map((ticket) => (\n          <li key={ticket.id}>\n            {ticket.title} ({ticket.status})\n            {ticket.status === \"open\" && (\n              <button type=\"button\" onClick={() => closeTicket(ticket.id)}>\n                Close\n              </button>\n            )}\n          </li>\n        ))}\n      </ul>\n\n      <form onSubmit={createTicket}>\n        <input\n          aria-label=\"New ticket title\"\n          value={title}\n          onChange={(event) => setTitle(event.target.value)}\n        />\n        <button type=\"submit\">Create</button>\n      </form>\n\n      {error && <p role=\"alert\">{error}</p>}\n      <p data-testid=\"open-count\">{openCount} open</p>\n    </main>\n  );\n}",
+    "hint": "Zoznam ticketov drž v React state namiesto priameho vykresľovania z `INITIAL_TICKETS`. Použi jednu hodnotu state pre filter, jednu pre vstup a jednu pre chybu validácie. Pri zatváraní ticketu vytvor nové pole pomocou `map`. Pri vytváraní ticketu vypočítaj ďalšie ID z aktuálnych ticketov a pripoj nový objekt. Viditeľný zoznam aj počet otvorených ticketov by mali byť odvodené z aktuálneho state.",
