+    "kind": "js",
+    "starter": "// Tiny in-memory backend.\n// The tests will call handleRequest() several times in the same page.\nlet tasks = [];\n\nfunction handleRequest(request) {\n  // TODO: implement GET /api/tasks and POST /api/tasks.\n  // POST should validate the title and create a new task.\n  // Other methods and paths should return a 404 response.\n}",
+    "solution": "let tasks = [];\n\nfunction handleRequest(request) {\n  if (request.method === 'GET' && request.path === '/api/tasks') {\n    return {\n      status: 200,\n      body: tasks\n    };\n  }\n\n  if (request.method === 'POST' && request.path === '/api/tasks') {\n    const title = request.body?.title;\n\n    if (typeof title !== 'string' || title.trim() === '') {\n      return {\n        status: 400,\n        body: { error: 'Title is required' }\n      };\n    }\n\n    const newTask = {\n      id: tasks.length + 1,\n      title,\n      done: false\n    };\n\n    tasks.push(newTask);\n\n    return {\n      status: 201,\n      body: newTask\n    };\n  }\n\n  return {\n    status: 404,\n    body: { error: 'Not found' }\n  };\n}",
