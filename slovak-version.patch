+    "solution": "function composeFile() {\n  return {\n    services: {\n      db: {\n        image: \"postgres:16\",\n        environment: {\n          POSTGRES_DB: \"shop\",\n          POSTGRES_USER: \"shop\",\n          POSTGRES_PASSWORD: \"secret\"\n        },\n        volumes: [\"db-data:/var/lib/postgresql/data\"],\n        healthcheck: {\n          test: [\"CMD-SHELL\", \"pg_isready -U shop\"],\n          interval: \"5s\",\n          retries: 5\n        }\n      },\n      api: {\n        build: \"./backend\",\n        environment: {\n          SPRING_DATASOURCE_URL: \"jdbc:postgresql://db:5432/shop\",\n          SPRING_DATASOURCE_USERNAME: \"shop\",\n          SPRING_DATASOURCE_PASSWORD: \"secret\"\n        },\n        depends_on: {\n          db: {\n            condition: \"service_healthy\"\n          }\n        },\n        ports: [\"8080:8080\"]\n      },\n      web: {\n        build: \"./frontend\",\n        depends_on: {\n          api: {\n            condition: \"service_started\"\n          }\n        },\n        ports: [\"80:80\"]\n      }\n    },\n    volumes: {\n      \"db-data\": {}\n    }\n  };\n}\n\nfunction startOrder(services) {\n  const names = Object.keys(services);\n  const nameSet = new Set(names);\n  const dependencies = new Map();\n\n  for (const name of names) {\n    const dependsOn = services[name]?.depends_on;\n    const deps = Array.isArray(dependsOn)\n      ? [...dependsOn]\n      : dependsOn && typeof dependsOn === \"object\"\n        ? Object.keys(dependsOn)\n        : [];\n\n    for (const dependency of deps) {\n      if (!nameSet.has(dependency)) {\n        throw new Error(`unknown dependency: ${dependency}`);\n      }\n    }\n\n    dependencies.set(name, new Set(deps));\n  }\n\n  const remaining = new Map();\n  for (const [name, deps] of dependencies) {\n    remaining.set(name, new Set(deps));\n  }\n\n  const result = [];\n\n  while (remaining.size > 0) {\n    const ready = [...remaining.keys()]\n      .filter((name) => remaining.get(name).size === 0)\n      .sort();\n\n    if (ready.length === 0) {\n      throw new Error(\"cycle detected in dependencies\");\n    }\n\n    for (const name of ready) {\n      result.push(name);\n      remaining.delete(name);\n    }\n\n    for (const deps of remaining.values()) {\n      for (const name of ready) {\n        deps.delete(name);\n      }\n    }\n  }\n\n  return result;\n}",
