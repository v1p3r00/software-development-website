+    "solution": "class TaskController {\n    private tasks: { id: number; title: string; done: boolean }[] = [];\n    private nextId = 1;\n\n    list(query?: { done?: boolean }) {\n        const tasks = query?.done === undefined\n            ? [...this.tasks]\n            : this.tasks.filter(task => task.done === query.done);\n\n        return { status: 200, body: tasks };\n    }\n\n    get(id: number) {\n        const task = this.tasks.find(task => task.id === id);\n\n        if (!task) {\n            return { status: 404, body: { error: \"Task not found\" } };\n        }\n\n        return { status: 200, body: task };\n    }\n\n    create(dto: { title: string }) {\n        const task = {\n            id: this.nextId++,\n            title: dto.title,\n            done: false\n        };\n\n        this.tasks.push(task);\n\n        return {\n            status: 201,\n            headers: { Location: `/api/tasks/${task.id}` },\n            body: task\n        };\n    }\n\n    update(id: number, dto: { title?: string; done?: boolean }) {\n        const task = this.tasks.find(task => task.id === id);\n\n        if (!task) {\n            return { status: 404, body: { error: \"Task not found\" } };\n        }\n\n        if (dto.title !== undefined) {\n            task.title = dto.title;\n        }\n\n        if (dto.done !== undefined) {\n            task.done = dto.done;\n        }\n\n        return { status: 200, body: task };\n    }\n\n    remove(id: number) {\n        const index = this.tasks.findIndex(task => task.id === id);\n\n        if (index === -1) {\n            return { status: 404, body: { error: \"Task not found\" } };\n        }\n\n        this.tasks.splice(index, 1);\n        return { status: 204, body: null };\n    }\n}",
+    "hint": "Pri get() a update() použi find(), pri remove() findIndex() spolu so splice(). V list() filtruj iba vtedy, keď je query?.done naozaj definované. V create() zvýš nextId až po jeho priradení. V update() porovnaj každú voliteľnú vlastnosť s undefined, aby sa zmenili iba zadané polia.",
