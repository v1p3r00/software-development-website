+    "task": "Napíš jeden SQL dopyt, ktorý vráti každú otvorenú úlohu spolu s menom používateľa. Výsledok musí obsahovať presne stĺpce `task_id`, `title` a `user_name`. Vrátiť sa majú iba úlohy, kde `done = 0`. Prepoj `tasks.user_id` s `users.id` a výsledok zoraď podľa `user_name` vzostupne a potom podľa `title` vzostupne. Dopyt musí vrátiť všetky potrebné dáta v jednej výslednej množine.",
+    "kind": "sql",
+    "setup": "CREATE TABLE users (\n  id INTEGER PRIMARY KEY,\n  name TEXT NOT NULL,\n  email TEXT NOT NULL UNIQUE\n);\n\nCREATE TABLE tasks (\n  id INTEGER PRIMARY KEY,\n  title TEXT NOT NULL,\n  done INTEGER NOT NULL DEFAULT 0,\n  user_id INTEGER NOT NULL,\n  FOREIGN KEY (user_id) REFERENCES users(id)\n);\n\nINSERT INTO users (id, name, email) VALUES\n  (1, 'Anna', 'anna@example.com'),\n  (2, 'Béla', 'bela@example.com'),\n  (3, 'Csilla', 'csilla@example.com'),\n  (4, 'Dávid', 'david@example.com');\n\nINSERT INTO tasks (id, title, done, user_id) VALUES\n  (1, 'API megtervezése', 0, 1),\n  (2, 'README frissítése', 1, 1),\n  (3, 'Adatbázis migráció', 0, 2),\n  (4, 'Teszt írása', 0, 2),\n  (5, 'Frontend javítása', 1, 3),\n  (6, 'Hibajegy ellenőrzése', 0, 3),\n  (7, 'Deploy előkészítése', 0, 4),\n  (8, 'Logolás hozzáadása', 1, 4),\n  (9, 'Dokumentáció írása', 0, 1),\n  (10, 'Régi task lezárása', 1, 2);",
