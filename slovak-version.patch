+    "solution": "function loadConfig(env: Record<string, string | undefined>) {\n  const problems: string[] = [];\n\n  let port = 8080;\n  if (env.PORT !== undefined) {\n    const parsed = Number(env.PORT);\n    if (!Number.isInteger(parsed) || parsed < 1 || parsed > 65535) {\n      problems.push(\"PORT must be an integer between 1 and 65535\");\n    } else {\n      port = parsed;\n    }\n  }\n\n  const databaseUrl = env.DATABASE_URL;\n  if (!databaseUrl) {\n    problems.push(\"DATABASE_URL is required\");\n  } else if (!databaseUrl.startsWith(\"jdbc:postgresql://\")) {\n    problems.push(\"DATABASE_URL must start with jdbc:postgresql://\");\n  }\n\n  const corsOrigins = env.CORS_ORIGINS === undefined\n    ? []\n    : env.CORS_ORIGINS\n        .split(\",\")\n        .map((origin) => origin.trim())\n        .filter((origin) => origin.length > 0);\n\n  const profile = env.APP_PROFILE === undefined ? \"dev\" : env.APP_PROFILE;\n  if (profile !== \"dev\" && profile !== \"prod\") {\n    problems.push(\"APP_PROFILE must be dev or prod\");\n  }\n\n  const jwtSecret = env.JWT_SECRET;\n  if (!jwtSecret) {\n    problems.push(\"JWT_SECRET is required\");\n  } else if (profile === \"prod\" && jwtSecret.length < 32) {\n    problems.push(\"JWT_SECRET must be at least 32 characters in prod\");\n  }\n\n  if (profile === \"prod\" && corsOrigins.includes(\"*\")) {\n    problems.push(\"CORS_ORIGINS must not contain * in prod\");\n  }\n\n  if (problems.length > 0) {\n    throw new Error(`Invalid config: ${problems.join(\"; \")}`);\n  }\n\n  return {\n    port,\n    databaseUrl,\n    corsOrigins,\n    profile,\n    jwtSecret\n  };\n}\n\nfunction redact(config: {\n  port: number;\n  databaseUrl: string;\n  corsOrigins: string[];\n  profile: \"dev\" | \"prod\";\n  jwtSecret: string;\n}) {\n  const databaseUrl = config.databaseUrl.replace(/(password=)[^&]*/i, \"$1***\");\n\n  return {\n    ...config,\n    databaseUrl,\n    corsOrigins: [...config.corsOrigins],\n    jwtSecret: \"***\"\n  };\n}",
