+        "name": "Použije presný ENTRYPOINT pre Javu",
+        "code": "const result = buildDockerfile({ javaVersion: 21, jarName: \"app.jar\", port: 8080 });\nreturn result.split(\"\\n\").includes('ENTRYPOINT [\"java\", \"-jar\", \"app.jar\"]');"
+      },
+      {
+        "name": "Pridá detached režim, keď je požadovaný",
+        "code": "const result = dockerRun({ image: \"task-api:1.0\", name: \"task-api\", detach: true });\nreturn result === \"docker run -d --name task-api task-api:1.0\";"
