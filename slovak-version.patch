+    "solution": "CREATE INDEX idx_tasks_user_status\nON tasks(user_id, status);\n\nSELECT id, title\nFROM tasks\nWHERE user_id = 3\n  AND status = 'open'\n  AND id > 40\nORDER BY id\nLIMIT 5;",
