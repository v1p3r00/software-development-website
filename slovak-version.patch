+        "code": "const services = {\n  web: { depends_on: { api: { condition: \"service_started\" } } },\n  api: {}\n};\nconst before = JSON.stringify(services);\nconst result = startOrder(services);\nconst after = JSON.stringify(services);\nif (JSON.stringify(result) !== JSON.stringify([\"api\", \"web\"]) || before !== after) return false;\n\nconst invalid = { api: { depends_on: [\"missing\"] } };\ntry {\n  startOrder(invalid);\n  return false;\n} catch (error) {\n  return String(error?.message).toLowerCase().includes(\"unknown\");\n}"
+      }
