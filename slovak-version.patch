+        "code": "const result = buildDockerfile({ javaVersion: 21, jarName: \"orders-service-1.2.3.jar\", port: 8080 });\nreturn result.split(\"\\n\").includes(\"COPY --from=build /app/target/orders-service-1.2.3.jar app.jar\");"
+      },
+      {
+        "name": "Umiestni USER za useradd",
+        "code": "const result = buildDockerfile({ javaVersion: 21, jarName: \"app.jar\", port: 8080 });\nconst lines = result.split(\"\\n\");\nconst useradd = lines.indexOf(\"RUN useradd --system appuser\");\nconst user = lines.indexOf(\"USER appuser\");\nreturn useradd !== -1 && user !== -1 && user > useradd;"
+      },
+      {
+        "name": "Sprístupní požadovaný port",
+        "code": "const result = buildDockerfile({ javaVersion: 21, jarName: \"app.jar\", port: 9090 });\nreturn result.split(\"\\n\").includes(\"EXPOSE 9090\");"
+      },
