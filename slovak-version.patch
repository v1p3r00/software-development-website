+    "solution": "function createLogger(opts: { level: \"debug\" | \"info\" | \"warn\" | \"error\"; now: () => string; write: (line: string) => void }) {\n  const levels = { debug: 0, info: 1, warn: 2, error: 3 } as const;\n\n  const redact = (value: unknown): unknown => {\n    if (Array.isArray(value)) {\n      return value.map((item) => redact(item));\n    }\n\n    if (value && typeof value === \"object\") {\n      const result: Record<string, unknown> = {};\n      for (const [key, item] of Object.entries(value)) {\n        if ([\"password\", \"token\", \"authorization\", \"secret\"].includes(key.toLowerCase())) {\n          result[key] = \"[REDACTED]\";\n        } else {\n          result[key] = redact(item);\n        }\n      }\n      return result;\n    }\n\n    return value;\n  };\n\n  const create = (context: Record<string, unknown>) => {\n    const log = (level: \"debug\" | \"info\" | \"warn\" | \"error\", message: string, fields: Record<string, unknown> = {}) => {\n      if (levels[level] < levels[opts.level]) {\n        return;\n      }\n\n      const entry = {\n        time: opts.now(),\n        level,\n        message,\n        ...fields,\n        ...context\n      };\n\n      opts.write(JSON.stringify(redact(entry)));\n    };\n\n    return {\n      debug: (message: string, fields?: Record<string, unknown>) => log(\"debug\", message, fields),\n      info: (message: string, fields?: Record<string, unknown>) => log(\"info\", message, fields),\n      warn: (message: string, fields?: Record<string, unknown>) => log(\"warn\", message, fields),\n      error: (message: string, fields?: Record<string, unknown>) => log(\"error\", message, fields),\n      child: (fields: Record<string, unknown> = {}) => create({ ...context, ...fields })\n    };\n  };\n\n  return create({});\n}\n\nfunction summarize(lines: string[]) {\n  const durations: number[] = [];\n  let total = 0;\n  let errors = 0;\n\n  for (const line of lines) {\n    try {\n      const value = JSON.parse(line);\n\n      if (typeof value.status === \"number\") {\n        total++;\n        if (value.status >= 500) {\n          errors++;\n        }\n      }\n\n      if (typeof value.durationMs === \"number\") {\n        durations.push(value.durationMs);\n      }\n    } catch {\n      // Ignore invalid JSON.\n    }\n  }\n\n  durations.sort((a, b) => a - b);\n\n  const p95 = durations.length === 0\n    ? null\n    : durations[Math.ceil(0.95 * durations.length) - 1];\n\n  return {\n    total,\n    errors,\n    errorRate: total === 0 ? 0 : Math.round((errors / total) * 1000) / 1000,\n    p95\n  };\n}",
