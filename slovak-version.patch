+        "code": "await db.exec(\"INSERT INTO customers (id, name, email) VALUES (1, 'Anna', 'anna@example.com')\");\nawait db.exec(\"INSERT INTO services (id, name, duration_minutes) VALUES (1, 'Consultation', 60)\");\nlet duplicateEmailRejected = false;\nlet zeroDurationRejected = false;\nlet unknownCustomerRejected = false;\nlet badStatusRejected = false;\ntry { await db.exec(\"INSERT INTO customers (id, name, email) VALUES (2, 'Another Anna', 'anna@example.com')\"); } catch (e) { duplicateEmailRejected = true; }\ntry { await db.exec(\"INSERT INTO services (id, name, duration_minutes) VALUES (2, 'Invalid', 0)\"); } catch (e) { zeroDurationRejected = true; }\ntry { await db.exec(\"INSERT INTO bookings (id, customer_id, service_id, starts_at) VALUES (1, 99, 1, '2026-10-10T10:00:00')\"); } catch (e) { unknownCustomerRejected = true; }\ntry { await db.exec(\"INSERT INTO bookings (id, customer_id, service_id, starts_at, status) VALUES (2, 1, 1, '2026-10-10T11:00:00', 'finished')\"); } catch (e) { badStatusRejected = true; }\nreturn duplicateEmailRejected && zeroDurationRejected && unknownCustomerRejected && badStatusRejected;"
+      },
