+        "name": "Vytvoria sa tagy work a home",
+        "code": "const rows = await query(`SELECT name\nFROM tags\nORDER BY name;`);\n\nif (rows.length !== 2) throw new Error(`Expected 2 tags, got ${rows.length}`);\nif (rows[0].name !== 'home') throw new Error('Expected home tag');\nif (rows[1].name !== 'work') throw new Error('Expected work tag');\n\nreturn true;"
+      },
+      {
+        "name": "Väzba úloha – tag sa nemôže objaviť dvakrát",
+        "code": "let failed = false;\n\ntry {\n  await query(`INSERT INTO task_tags (task_id, tag_id)\n  VALUES (1, 1), (1, 1);`);\n} catch (error) {\n  failed = true;\n}\n\nif (!failed) throw new Error('Expected duplicate task-tag pair to be rejected');\n\nreturn true;"
+      },
+      {
