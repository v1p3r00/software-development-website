+        "code": "const result = buildDockerfile({ javaVersion: 17, jarName: \"app.jar\", port: 8081 });\nconst lines = result.split(\"\\n\");\nreturn lines.includes(\"FROM eclipse-temurin:17-jdk AS build\") && lines.includes(\"FROM eclipse-temurin:17-jre\");"
