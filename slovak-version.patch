+        "code": "const result = buildDockerfile({ javaVersion: 21, jarName: \"task-api.jar\", port: 8080 });\nconst lines = result.split(\"\\n\");\nconst required = [\n  \"FROM eclipse-temurin:21-jdk AS build\",\n  \"WORKDIR /app\",\n  \"COPY . .\",\n  \"RUN ./mvnw -q package -DskipTests\",\n  \"FROM eclipse-temurin:21-jre\",\n  \"WORKDIR /app\",\n  \"COPY --from=build /app/target/task-api.jar app.jar\",\n  \"RUN useradd --system appuser\",\n  \"USER appuser\",\n  \"EXPOSE 8080\",\n  'ENTRYPOINT [\"java\", \"-jar\", \"app.jar\"]'\n];\nlet previous = -1;\nfor (const line of required) {\n  const index = lines.indexOf(line, previous + 1);\n  if (index === -1 || index <= previous) return false;\n  previous = index;\n}\nreturn true;"
