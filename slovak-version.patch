+    "starter": "const AuthContext = React.createContext(null);\n\nfunction AuthProvider({ children }) {\n  return children;\n}\n\nfunction RequireAuth({ role, children }) {\n  return <div>{children}</div>;\n}\n\nfunction App() {\n  return (\n    <AuthProvider>\n      <div>\n        <button>Log in as user</button>\n        <button>Log in as admin</button>\n        <button>Log out</button>\n\n        <RequireAuth>\n          <h2>Dashboard</h2>\n        </RequireAuth>\n\n        <RequireAuth role=\"ADMIN\">\n          <h2>Admin</h2>\n        </RequireAuth>\n      </div>\n    </AuthProvider>\n  );\n}\n",
+    "solution": "const AuthContext = React.createContext(null);\n\nfunction AuthProvider({ children }) {\n  const [user, setUser] = React.useState(null);\n\n  function login(name, role) {\n    setUser({ name, role });\n  }\n\n  function logout() {\n    setUser(null);\n  }\n\n  return (\n    <AuthContext.Provider value={{ user, login, logout }}>\n      {children}\n    </AuthContext.Provider>\n  );\n}\n\nfunction RequireAuth({ role, children }) {\n  const { user } = React.useContext(AuthContext);\n\n  if (!user) {\n    return <p data-testid=\"denied\">Please log in</p>;\n  }\n\n  if (role && user.role !== role) {\n    return <p data-testid=\"denied\">Not allowed</p>;\n  }\n\n  return <>{children}</>;\n}\n\nfunction Screen() {\n  const { login, logout } = React.useContext(AuthContext);\n\n  return (\n    <div>\n      <button onClick={() => login(\"Anna\", \"USER\")}>Log in as user</button>\n      <button onClick={() => login(\"Bence\", \"ADMIN\")}>Log in as admin</button>\n      <button onClick={logout}>Log out</button>\n\n      <RequireAuth>\n        <h2>Dashboard</h2>\n      </RequireAuth>\n\n      <RequireAuth role=\"ADMIN\">\n        <h2>Admin</h2>\n      </RequireAuth>\n    </div>\n  );\n}\n\n// App obalí všetko do providera, aby každý komponent mohol čítať auth context.\nfunction App() {\n  return (\n    <AuthProvider>\n      <Screen />\n    </AuthProvider>\n  );\n}\n",
