+    "solution": "function can(user: { id: string; roles: string[] } | null, action: \"read\" | \"update\" | \"delete\", task: { id: string; ownerId: string; shared: boolean }): boolean {\n  if (user === null) {\n    return false;\n  }\n\n  if (user.roles.includes(\"ADMIN\")) {\n    return true;\n  }\n\n  const isOwner = user.id === task.ownerId;\n\n  if (isOwner) {\n    return true;\n  }\n\n  return action === \"read\" && task.shared;\n}\n\nfunction statusFor(user: { id: string; roles: string[] } | null, allowed: boolean): number {\n  if (user === null) {\n    return 401;\n  }\n\n  return allowed ? 200 : 403;\n}",
