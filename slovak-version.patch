+    "starter": "const ACTION_VERBS = [\n  \"built\",\n  \"designed\",\n  \"implemented\",\n  \"reduced\",\n  \"improved\",\n  \"automated\",\n  \"migrated\",\n  \"led\",\n  \"created\",\n  \"delivered\"\n];\n\nfunction reviewBullet(text) {\n  return { score: 0, tips: [] };\n}\n\nfunction starCheck(answer) {\n  return [];\n}",
+    "solution": "const ACTION_VERBS = [\n  \"built\",\n  \"designed\",\n  \"implemented\",\n  \"reduced\",\n  \"improved\",\n  \"automated\",\n  \"migrated\",\n  \"led\",\n  \"created\",\n  \"delivered\"\n];\n\nfunction reviewBullet(text) {\n  const trimmed = typeof text === \"string\" ? text.trim() : \"\";\n  const firstWord = trimmed.split(/\\s+/)[0]?.replace(/^[^a-z]+|[^a-z]+$/gi, \"\").toLowerCase() ?? \"\";\n  const hasActionVerb = ACTION_VERBS.includes(firstWord);\n  const hasDigit = /\\d/.test(trimmed);\n  const validLength = trimmed.length >= 40 && trimmed.length <= 160;\n  const hasPassivePhrase = /responsible for|worked on/i.test(trimmed);\n\n  let score = 0;\n  const tips = [];\n\n  if (hasActionVerb) score += 1;\n  else tips.push(\"Start with an action verb\");\n\n  if (hasDigit) score += 1;\n  else tips.push(\"Add a number that shows impact\");\n\n  if (validLength) score += 1;\n  else tips.push(\"Keep it between 40 and 160 characters\");\n\n  if (!hasPassivePhrase) score += 1;\n  else tips.push(\"Avoid passive phrases like 'responsible for'\");\n\n  return { score, tips };\n}\n\nfunction starCheck(answer) {\n  const parts = [\"situation\", \"task\", \"action\", \"result\"];\n  const missing = [];\n\n  for (const part of parts) {\n    const value = answer?.[part];\n    if (typeof value !== \"string\" || value.trim() === \"\") {\n      missing.push(part);\n    }\n  }\n\n  const result = answer?.result;\n  if (typeof result === \"string\" && result.trim() !== \"\" && !/\\d/.test(result)) {\n    missing.push(\"result needs a number\");\n  }\n\n  return missing;\n}",
