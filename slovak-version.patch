+        "code": "const healthcheck = composeFile()?.services?.db?.healthcheck;\nreturn Array.isArray(healthcheck?.test) &&\n  healthcheck.test.length === 2 &&\n  healthcheck.test[0] === \"CMD-SHELL\" &&\n  healthcheck.test[1] === \"pg_isready -U shop\" &&\n  healthcheck.interval === \"5s\" &&\n  healthcheck.retries === 5;"
+      },
+      {
+        "name": "Deklaruje pomenovaný databázový zväzok",
+        "code": "const stack = composeFile();\nreturn stack?.services?.db?.volumes?.includes(\"db-data:/var/lib/postgresql/data\") === true &&\n  Object.prototype.hasOwnProperty.call(stack?.volumes ?? {}, \"db-data\");"
+      },
+      {
+        "name": "Nastavuje health závislosti služieb",
+        "code": "const stack = composeFile();\nreturn stack?.services?.api?.depends_on?.db?.condition === \"service_healthy\" &&\n  stack?.services?.web?.depends_on?.api?.condition === \"service_started\";"
+      },
+      {
+        "name": "Zoradí Compose stack ako db, api, web",
+        "code": "const stack = composeFile();\nreturn JSON.stringify(startOrder(stack.services)) === JSON.stringify([\"db\", \"api\", \"web\"]);"
+      },
+      {
+        "name": "Podporuje závislosti zadané ako pole",
+        "code": "const services = {\n  web: { depends_on: [\"api\", \"cache\"] },\n  api: { depends_on: [\"db\"] },\n  cache: {},\n  db: {}\n};\nreturn JSON.stringify(startOrder(services)) === JSON.stringify([\"cache\", \"db\", \"api\", \"web\"]);"
+      },
+      {
+        "name": "Pri službách pripravených naraz používa abecedné poradie",
+        "code": "const services = {\n  zebra: {},\n  alpha: {},\n  middle: {}\n};\nreturn JSON.stringify(startOrder(services)) === JSON.stringify([\"alpha\", \"middle\", \"zebra\"]);"
+      },
+      {
+        "name": "Pri cyklických závislostiach vyhodí chybu obsahujúcu cycle",
+        "code": "const services = {\n  api: { depends_on: [\"db\"] },\n  db: { depends_on: [\"api\"] }\n};\ntry {\n  startOrder(services);\n  return false;\n} catch (error) {\n  return String(error?.message).toLowerCase().includes(\"cycle\");\n}"
+      },
