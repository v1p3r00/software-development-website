+      },
+      {
+        "name": "Pokračuje po neúspešnom teste",
+        "code": "test(\"fails\", () => { throw new Error(\"boom\"); }); test(\"still runs\", () => { expect(true).toBe(true); }); const report = await run(); return report.length === 2 && report[0].passed === false && report[1].passed === true;"
+      },
