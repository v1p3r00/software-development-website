+    "solution": "class Db {\n  constructor() {\n    this.tasks = new Map();\n    this.closed = false;\n    this.nextId = 1;\n  }\n\n  insert(task) {\n    const id = String(this.nextId++);\n    this.tasks.set(id, { id, ...task });\n    return this.tasks.get(id);\n  }\n\n  all() {\n    return [...this.tasks.values()];\n  }\n\n  close() {\n    this.closed = true;\n  }\n}\n\nfunction createApp(db) {\n  return {\n    async handle(request) {\n      if (request.method === \"POST\" && request.path === \"/api/tasks\") {\n        const title = request.body?.title;\n\n        if (typeof title !== \"string\" || title.trim() === \"\") {\n          return { status: 400, body: { error: \"Title is required\" } };\n        }\n\n        return {\n          status: 201,\n          body: db.insert({ title: title.trim() })\n        };\n      }\n\n      if (request.method === \"GET\" && request.path === \"/api/tasks\") {\n        return { status: 200, body: db.all() };\n      }\n\n      return { status: 404, body: { error: \"Not found\" } };\n    }\n  };\n}\n\nasync function withTestApp(testFn) {\n  const db = new Db();\n  const app = createApp(db);\n\n  db.insert({ title: \"Seed task 1\" });\n  db.insert({ title: \"Seed task 2\" });\n\n  try {\n    return await testFn(app, db);\n  } finally {\n    db.closed = true;\n  }\n}",
