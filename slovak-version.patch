+      {
+        "name": "Existujúce úlohy zostanú s prioritou normal",
+        "code": "const rows = await query(`SELECT id, title, done, priority\nFROM tasks\nORDER BY id;`);\n\nif (rows.length !== 4) throw new Error(`Expected 4 tasks, got ${rows.length}`);\n\nfor (const row of rows) {\n  if (row.priority !== 'normal') {\n    throw new Error(`Task ${row.id} should have priority normal`);\n  }\n}\n\nreturn true;"
+      },
+      {
+        "name": "CHECK pre prioritu odmietne hodnotu urgent",
+        "code": "let failed = false;\n\ntry {\n  await query(`INSERT INTO tasks (title, done, priority)\n  VALUES ('Hibás prioritás', 0, 'urgent');`);\n} catch (error) {\n  failed = true;\n}\n\nif (!failed) throw new Error('Expected the priority CHECK constraint to reject urgent');\n\nreturn true;"
+      },
