+    "solution": "function jobStages(jobs) {\n  const names = Object.keys(jobs);\n  const nameSet = new Set(names);\n  const dependencies = new Map();\n\n  for (const name of names) {\n    const needs = jobs[name]?.needs;\n    const deps = needs === undefined\n      ? []\n      : Array.isArray(needs)\n        ? [...needs]\n        : [needs];\n\n    for (const dependency of deps) {\n      if (!nameSet.has(dependency)) {\n        throw new Error(`unknown dependency: ${dependency}`);\n      }\n    }\n\n    dependencies.set(name, new Set(deps));\n  }\n\n  const remaining = new Map();\n  for (const [name, deps] of dependencies) {\n    remaining.set(name, new Set(deps));\n  }\n\n  const stages = [];\n\n  while (remaining.size > 0) {\n    const ready = [...remaining.keys()]\n      .filter((name) => remaining.get(name).size === 0)\n      .sort();\n\n    if (ready.length === 0) {\n      throw new Error(\"cycle detected in job dependencies\");\n    }\n\n    stages.push(ready);\n\n    for (const name of ready) {\n      remaining.delete(name);\n    }\n\n    for (const deps of remaining.values()) {\n      for (const name of ready) {\n        deps.delete(name);\n      }\n    }\n  }\n\n  return stages;\n}\n\nfunction expandMatrix(matrix) {\n  const keys = Object.keys(matrix).filter((key) => key !== \"include\" && key !== \"exclude\");\n  const combinations = [];\n\n  function build(index, current) {\n    if (index === keys.length) {\n      combinations.push({ ...current });\n      return;\n    }\n\n    const key = keys[index];\n    for (const value of matrix[key]) {\n      current[key] = value;\n      build(index + 1, current);\n    }\n  }\n\n  if (keys.length === 0) {\n    combinations.push({});\n  } else {\n    build(0, {});\n  }\n\n  const excluded = combinations.filter((combo) => {\n    return !(matrix.exclude ?? []).some((rule) => {\n      return Object.keys(rule).every((key) => combo[key] === rule[key]);\n    });\n  });\n\n  for (const include of matrix.include ?? []) {\n    excluded.push({ ...include });\n  }\n\n  return excluded;\n}\n\nfunction shouldRun(trigger, event) {\n  const config = trigger?.[event?.name];\n\n  if (!config) {\n    return false;\n  }\n\n  if (!Array.isArray(config.branches)) {\n    return true;\n  }\n\n  return config.branches.some((pattern) => {\n    if (pattern.endsWith(\"/*\")) {\n      const prefix = pattern.slice(0, -1);\n      return typeof event.branch === \"string\" && event.branch.startsWith(prefix);\n    }\n\n    return event.branch === pattern;\n  });\n}",
