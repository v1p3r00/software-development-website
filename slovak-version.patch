+    "solution": "function isGoodCommitMessage(message) {\n  if (typeof message !== 'string') return false;\n\n  const lines = message.split('\\n');\n  const subject = lines[0];\n\n  if (subject.length === 0 || subject.length > 50) return false;\n  if (subject.endsWith('.')) return false;\n  if (!/^[A-Z]/.test(subject)) return false;\n\n  if (lines.length > 1 && lines[1] !== '') return false;\n\n  return true;\n}\n\nfunction summarize(files) {\n  const result = {};\n\n  for (const file of files) {\n    result[file.status] = (result[file.status] ?? 0) + 1;\n  }\n\n  return result;\n}",
